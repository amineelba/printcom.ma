# ---------------------------------------------------------------------------
# Printcom.ma — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printcom

# Payload
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Media storage (Vercel Blob or S3-compatible object storage)
BLOB_READ_WRITE_TOKEN=

# Outbound email
# EMAIL_PROVIDER: "resend" | "smtp" | "console" (default "console" logs instead of sending)
EMAIL_PROVIDER=console
EMAIL_FROM="Printcom <no-reply@printcom.ma>"
EMAIL_REPLY_TO=contact@printcom.ma
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Internal recipients for structured submissions
PRINTCOM_QUOTE_RECIPIENTS=devis@printcom.ma
PRINTCOM_CONTACT_RECIPIENTS=contact@printcom.ma

# Bootstrap admin account (used by scripts/create-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uploads and retention
FILE_UPLOAD_MAX_SIZE=15728640
QUOTE_RETENTION_DAYS=365
CONTACT_RETENTION_DAYS=365

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
